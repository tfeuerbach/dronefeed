# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars.
# Prefer: ./setup.sh (writes tfvars + secrets.auto.tfvars + SSH key).

aws_region    = "us-east-1"
name_prefix   = "dronefeed"
instance_type = "c7i.2xlarge" # c7i.4xlarge+ for >4 public feeds
root_volume_gb = 80

tags = {
  Project     = "dronefeed"
  Environment = "prod"
  # Owner       = "platform@example.com"
  # CostCenter  = "research"
}

# Prefer locking SSH to your IP; media can stay open for research pull tools.
# ssh_ingress_cidrs  = ["203.0.113.10/32"]
# media_ingress_cidrs = ["0.0.0.0/0"]

# SSH — setup.sh sets both from your ~/.ssh/*.pub or deploy/terraform/keys/
# public_key         = "ssh-ed25519 AAAA... you@laptop"
# ssh_authorized_key = "ssh-ed25519 AAAA... you@laptop"  # installed for dronefeed user

git_repo_url = "https://github.com/tfeuerbach/dronefeed.git"
git_ref      = "master" # must include Caddyfile.http + runtime PHX_SCHEME/force_ssl (http skips force_ssl)

# Bootstrap admin (password → secrets.auto.tfvars)
# admin_email = "admin@dronefeed.local"
# admin_password = "…"  # in secrets.auto.tfvars

enable_ssm           = true
enable_ses_send      = false # app SMTP policy; separate from SNS ops alerts
associate_elastic_ip = true

# SNS operator alerts (schedule miss / on-too-long / monthly budget) + setup.sh bootstrap mail.
# Confirm the AWS subscription email once after apply.
# enable_ops_alerts  = true
# ops_alert_email    = "you@example.com"
# monthly_budget_usd = 500

# CloudWatch Logs retention for Compose services (dashboard always created).
# log_retention_days = 14

# After-hours offline page (S3 + CloudFront).
# enable_maintenance_static       = true
# maintenance_create_bucket       = true
# maintenance_bucket_name         = ""
# maintenance_bucket_same_account = true
# maintenance_bucket_region       = ""

# Weekday auto start/stop (default on: 8→18 local). After-hours: ./wake.sh 4|8|12
enable_business_hours_schedule = true
schedule_timezone              = "America/New_York"
schedule_start_hour            = 8
schedule_stop_hour             = 18
