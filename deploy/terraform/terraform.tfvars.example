# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars.

aws_region   = "us-east-1"
name_prefix  = "dronefeed"
instance_type = "c7i.2xlarge" # c7i.4xlarge+ for >4 public feeds
root_volume_gb = 80

tags = {
  Project     = "dronefeed"
  Environment = "prod"
  # Owner       = "platform@example.com"
  # CostCenter  = "research"
}

# Prefer locking SSH to your IP; media can stay open for research pull tools.
# ssh_ingress_cidrs  = ["203.0.113.10/32"]
# media_ingress_cidrs = ["0.0.0.0/0"]

# One of:
#   key_name  = "my-existing-keypair"
#   public_key = "ssh-ed25519 AAAA... you@laptop"

git_repo_url = "https://github.com/tfeuerbach/dronefeed.git"
git_ref      = "master"

enable_ssm            = true
enable_ses_send       = true
associate_elastic_ip  = true

# After-hours offline page (S3 + CloudFront). Customize later via deploy/maintenance.
# enable_maintenance_static       = true
# maintenance_create_bucket       = true   # false = use existing maintenance_bucket_name
# maintenance_bucket_name         = ""     # required if create=false; optional name if create=true
# maintenance_bucket_same_account = true   # false = set keys in secrets.auto.tfvars
# maintenance_bucket_region       = ""     # empty = aws_region
# Cross-account only (gitignored secrets.auto.tfvars):
#   maintenance_bucket_access_key    = "AKIA..."
#   maintenance_bucket_secret_key    = "..."
#   maintenance_bucket_session_token = ""  # optional

# Weekday auto start/stop (EventBridge Scheduler). Off by default.
# enable_business_hours_schedule = true
# schedule_timezone   = "America/New_York"
# schedule_start_hour = 8   # 8:00 local Mon–Fri
# schedule_stop_hour  = 18  # 18:00 local Mon–Fri
