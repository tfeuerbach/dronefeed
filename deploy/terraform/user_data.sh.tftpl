#!/bin/bash
set -euxo pipefail

# DroneFeed host bootstrap — Amazon Linux 2023
# IP-first: stamps plain HTTP .env from IMDS public IP and starts Compose once.

DEPLOY_USER="${deploy_user}"
GIT_REPO_URL="${git_repo_url}"
GIT_REF="${git_ref}"
INSTALL_ROOT="/opt/drone-feed"
DEPLOY_DIR="$INSTALL_ROOT/deploy"
CREDENTIALS_FILE="$INSTALL_ROOT/DEPLOY.txt"
BOOTSTRAP_MARKER="$INSTALL_ROOT/.bootstrap-complete"

# Terraform-supplied secrets (base64 to avoid shell metacharacter issues).
SSH_AUTHORIZED_KEY="$(printf '%s' '${ssh_authorized_key_b64}' | base64 -d)"
ADMIN_EMAIL="$(printf '%s' '${admin_email_b64}' | base64 -d)"
ADMIN_PASSWORD="$(printf '%s' '${admin_password_b64}' | base64 -d)"

AWS_REGION="${aws_region}"
NAME_PREFIX="${name_prefix}"

dnf -y update
# rsyslog: AL2023 is journald-only by default; CW Agent + OOM filter need /var/log/messages.
dnf -y install docker git openssl python3 dnf-automatic amazon-cloudwatch-agent rsyslog
systemctl enable --now rsyslog

# AL2023 AMIs lock to a repo snapshot; without this, dnf-automatic never sees
# newer security advisories. Fine for a single long-lived niche host.
printf 'latest\n' >/etc/dnf/vars/releasever

# Security-only auto-apply (not full upgrades). Timer installs when available.
python3 - <<'PY'
from pathlib import Path

path = Path("/etc/dnf/automatic.conf")
text = path.read_text()
out = []
section = None
for line in text.splitlines():
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        section = stripped[1:-1]
        out.append(line)
        continue
    if section == "commands" and "=" in line and not stripped.startswith("#"):
        key = stripped.split("=", 1)[0].strip()
        if key == "upgrade_type":
            out.append("upgrade_type = security")
            continue
        if key == "apply_updates":
            out.append("apply_updates = yes")
            continue
    out.append(line)
path.write_text("\n".join(out) + "\n")
PY
systemctl enable --now dnf-automatic-install.timer

# Swap for first-boot Docker/Elixir builds (OOM/137 without it on smaller boxes).
if ! swapon --show 2>/dev/null | grep -q .; then
  if fallocate -l 4G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=4096 status=none; then
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    grep -q '^/swapfile ' /etc/fstab 2>/dev/null || echo '/swapfile none swap sw 0 0' >>/etc/fstab
  else
    echo "WARN: could not create /swapfile; compose build may OOM on small instances" >&2
  fi
fi

systemctl enable --now docker

# CloudWatch Agent — mem/disk/swap + bootstrap/system logs.
# Quoted heredoc: bash set -u must not expand the agent InstanceId placeholder.
# Terraform escapes that token as dollar-dollar-brace so the rendered script keeps
# the literal agent form inside the quoted heredoc body.
install -d -m 755 /opt/aws/amazon-cloudwatch-agent/etc
cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWCFG'
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "$${aws:InstanceId}"
    },
    "aggregation_dimensions": [
      ["InstanceId"],
      ["InstanceId", "path"]
    ],
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"]
      },
      "swap": {
        "measurement": ["swap_used_percent"]
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"],
        "drop_device": true,
        "ignore_file_system_types": ["sysfs", "devtmpfs", "tmpfs", "overlay", "nsfs"]
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/drone-feed/compose-bootstrap.log",
            "log_group_name": "/__NAME_PREFIX__/bootstrap",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/messages",
            "log_group_name": "/__NAME_PREFIX__/system",
            "log_stream_name": "{instance_id}/messages",
            "retention_in_days": 14
          }
        ]
      }
    }
  }
}
CWCFG
sed -i "s|__NAME_PREFIX__|${name_prefix}|g" /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json || true

# Compose v2 plugin (AL2023 may already ship it; otherwise pin a known release).
if ! docker compose version >/dev/null 2>&1; then
  mkdir -p /usr/local/lib/docker/cli-plugins
  curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
    -o /usr/local/lib/docker/cli-plugins/docker-compose
  chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
fi

# High-bitrate SRT / MPEG-TS UDP (same values as deploy/README.md)
cat >/etc/sysctl.d/99-dronefeed-udp.conf <<'SYSCTL'
net.core.rmem_max=268435456
net.core.wmem_max=268435456
net.core.rmem_default=16777216
net.core.wmem_default=16777216
SYSCTL
sysctl --system || sysctl -p /etc/sysctl.d/99-dronefeed-udp.conf

id -u "$DEPLOY_USER" >/dev/null 2>&1 || useradd -m -s /bin/bash "$DEPLOY_USER"
usermod -aG docker "$DEPLOY_USER"
usermod -aG wheel "$DEPLOY_USER" || true

# Key-only SSH + passwordless sudo (no Linux password is set for deploy_user).
cat >"/etc/sudoers.d/90-${deploy_user}" <<'SUDOERS'
# Managed by DroneFeed cloud-init — deploy operator may sudo without a password.
${deploy_user} ALL=(ALL) NOPASSWD:ALL
SUDOERS
chmod 440 "/etc/sudoers.d/90-${deploy_user}"
visudo -cf "/etc/sudoers.d/90-${deploy_user}"

# SSH access for deploy_user (same key as the EC2 key pair).
install -d -m 700 -o "$DEPLOY_USER" -g "$DEPLOY_USER" "/home/$DEPLOY_USER/.ssh"
printf '%s\n' "$SSH_AUTHORIZED_KEY" >"/home/$DEPLOY_USER/.ssh/authorized_keys"
chown "$DEPLOY_USER:$DEPLOY_USER" "/home/$DEPLOY_USER/.ssh/authorized_keys"
chmod 600 "/home/$DEPLOY_USER/.ssh/authorized_keys"

# Clone into a temp dir then move — avoids "destination path already exists" failures.
TMP_CLONE="$(mktemp -d /tmp/dronefeed-clone.XXXXXX)"
if [[ ! -d "$INSTALL_ROOT/.git" ]]; then
  rm -rf "$INSTALL_ROOT"
  git clone --branch "$GIT_REF" --depth 1 "$GIT_REPO_URL" "$TMP_CLONE/repo"
  mv "$TMP_CLONE/repo" "$INSTALL_ROOT"
else
  git -C "$INSTALL_ROOT" fetch --depth 1 origin "$GIT_REF"
  git -C "$INSTALL_ROOT" checkout "$GIT_REF"
  git -C "$INSTALL_ROOT" reset --hard "FETCH_HEAD"
fi
rm -rf "$TMP_CLONE"
chown -R "$DEPLOY_USER:$DEPLOY_USER" "$INSTALL_ROOT"

# Wait for public IPv4 (EIP is on the primary ENI before first boot when Terraform uses ENI+EIP).
PUBLIC_IP=""
for _ in $(seq 1 60); do
  TOKEN="$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" || true)"
  if [[ -n "$TOKEN" ]]; then
    PUBLIC_IP="$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" \
      http://169.254.169.254/latest/meta-data/public-ipv4 || true)"
  fi
  if [[ -n "$PUBLIC_IP" ]]; then
    break
  fi
  sleep 2
done

if [[ -z "$PUBLIC_IP" ]]; then
  echo "WARN: no public-ipv4 from IMDS; Compose will not auto-start." >&2
elif [[ -f "$BOOTSTRAP_MARKER" ]]; then
  echo "Bootstrap already completed; skipping .env stamp and compose up."
else
  SECRET_KEY_BASE="$(openssl rand -base64 48 | tr -d '\n')"
  POSTGRES_PASSWORD="$(openssl rand -base64 24 | tr -d '\n=/+' | cut -c1-24)"

  export DEPLOY_DIR PUBLIC_IP SECRET_KEY_BASE POSTGRES_PASSWORD ADMIN_EMAIL ADMIN_PASSWORD

  if [[ ! -f "$DEPLOY_DIR/.env" ]]; then
    cp "$DEPLOY_DIR/.env.example" "$DEPLOY_DIR/.env"
  fi

  python3 - <<'PY'
import os
from pathlib import Path

path = Path(os.environ["DEPLOY_DIR"]) / ".env"
replacements = {
    "PHX_HOST": os.environ["PUBLIC_IP"],
    "MEDIA_IP": os.environ["PUBLIC_IP"],
    "MEDIA_HOST": "",
    "CADDYFILE": "Caddyfile.http",
    "PHX_SCHEME": "http",
    "SECRET_KEY_BASE": os.environ["SECRET_KEY_BASE"],
    "POSTGRES_PASSWORD": os.environ["POSTGRES_PASSWORD"],
    "ADMIN_EMAIL": os.environ["ADMIN_EMAIL"],
    "ADMIN_PASSWORD": os.environ["ADMIN_PASSWORD"],
    "SMTP_HOST": "",
    "SMTP_USER": "",
    "SMTP_PASSWORD": "",
}
text = path.read_text()
lines = []
seen = set()
for line in text.splitlines():
    if not line or line.lstrip().startswith("#") or "=" not in line:
        lines.append(line)
        continue
    key, _, _ = line.partition("=")
    key = key.strip()
    if key in replacements:
        lines.append(f"{key}={replacements[key]}")
        seen.add(key)
    else:
        lines.append(line)
for key, value in replacements.items():
    if key not in seen:
        lines.append(f"{key}={value}")
path.write_text("\n".join(lines) + "\n")
PY

  chown "$DEPLOY_USER:$DEPLOY_USER" "$DEPLOY_DIR/.env"
  chmod 600 "$DEPLOY_DIR/.env"

  # Ship Compose container logs to CloudWatch (groups pre-created by Terraform).
  cat >"$DEPLOY_DIR/docker-compose.logging.yml" <<LOGYAML
services:
  web:
    logging:
      driver: awslogs
      options:
        awslogs-region: ${aws_region}
        awslogs-group: /${name_prefix}/web
        awslogs-stream: web
        awslogs-create-group: "false"
  caddy:
    logging:
      driver: awslogs
      options:
        awslogs-region: ${aws_region}
        awslogs-group: /${name_prefix}/caddy
        awslogs-stream: caddy
        awslogs-create-group: "false"
  mediamtx:
    logging:
      driver: awslogs
      options:
        awslogs-region: ${aws_region}
        awslogs-group: /${name_prefix}/mediamtx
        awslogs-stream: mediamtx
        awslogs-create-group: "false"
  db:
    logging:
      driver: awslogs
      options:
        awslogs-region: ${aws_region}
        awslogs-group: /${name_prefix}/db
        awslogs-stream: db
        awslogs-create-group: "false"
LOGYAML
  chown "$DEPLOY_USER:$DEPLOY_USER" "$DEPLOY_DIR/docker-compose.logging.yml"

  cat >"$CREDENTIALS_FILE" <<CREDS
DroneFeed first-boot credentials (plain HTTP — not TLS)
URL:      http://$PUBLIC_IP
Email:    $ADMIN_EMAIL
Password: $ADMIN_PASSWORD

SSH:      ssh ${deploy_user}@$PUBLIC_IP
Change the admin password after first login.
This file is only on the instance: $CREDENTIALS_FILE
CREDS
  chown "$DEPLOY_USER:$DEPLOY_USER" "$CREDENTIALS_FILE"
  chmod 600 "$CREDENTIALS_FILE"

  touch "$INSTALL_ROOT/compose-bootstrap.log"
  chown "$DEPLOY_USER:$DEPLOY_USER" "$INSTALL_ROOT/compose-bootstrap.log"
  (
    cd "$DEPLOY_DIR"
    docker compose -f docker-compose.yml -f docker-compose.logging.yml --env-file .env up -d --build
  ) >"$INSTALL_ROOT/compose-bootstrap.log" 2>&1 && touch "$BOOTSTRAP_MARKER" || {
    echo "WARN: docker compose failed; see $INSTALL_ROOT/compose-bootstrap.log" >&2
  }
  chown "$DEPLOY_USER:$DEPLOY_USER" "$BOOTSTRAP_MARKER" 2>/dev/null || true
fi

cat >/etc/motd <<MOTD
DroneFeed host (${name_prefix})
Repo: $INSTALL_ROOT

Open http://$${PUBLIC_IP:-(EIP)} in a browser (plain HTTP, no TLS).
Admin credentials: $CREDENTIALS_FILE
Compose log:       $INSTALL_ROOT/compose-bootstrap.log
SSH:               ssh $DEPLOY_USER@<EIP>

Optional later: point a domain A record at the Elastic IP, set
  PHX_HOST / MEDIA_HOST / CADDYFILE=Caddyfile / PHX_SCHEME=https / ACME_EMAIL
then recreate caddy. See deploy/terraform/README.md
MOTD
