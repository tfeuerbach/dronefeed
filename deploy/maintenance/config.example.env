# Copy to config.env (or run ./configure.sh) and fill in your values.
# Defaults are agnostic placeholders — nothing here is tied to a specific deploy.

# Public hostname users open in the browser (Cloudflare Proxied A → your EIP)
SITE_HOST='dronefeed.example.com'

# Cloudflare Worker route (usually SITE_HOST/*)
WORKER_ROUTE='dronefeed.example.com/*'

# Suggested Worker name in the Cloudflare dashboard
WORKER_NAME='dronefeed-after-hours'

# HTTPS URL of the static page on S3/CloudFront (or any public HTTPS host)
MAINTENANCE_URL='https://YOUR_DISTRIBUTION.cloudfront.net/index.html'

# Base URL for brand-mark.svg (defaults to directory of MAINTENANCE_URL if empty)
ASSET_BASE_URL=''

# How long the Worker waits on the origin before showing the maintenance page (ms)
ORIGIN_TIMEOUT_MS='2500'

# Page copy
BRAND_NAME='DroneFeed'
PAGE_TITLE='DroneFeed is down after hours'
PAGE_EYEBROW='Service offline'
PAGE_HEADLINE='DroneFeed is down after hours'
PAGE_LEDE='The app server is powered off to save cost. Feeds, uploads, and pull URLs will be back when the host is started again.'
PAGE_META='<strong>HTTP UI only.</strong> SRT / RTSP / RTMP ingest and pull stay unreachable until the instance is running.'
FALLBACK_TEXT='DroneFeed is down after hours'
