# Minimum for 4K ~100Mbps multi-reader SRT: c7i.2xlarge (8 vCPU). See deploy/README.md.
# DroneFeed production env — copy to deploy/.env

# Domain / TLS
PHX_HOST=dronefeed.tfeuerbach.dev
ACME_EMAIL=dronefeed@tfeuerbach.dev

# Media (public pull)
MEDIA_IP=
MEDIA_HOST=dronefeed.tfeuerbach.dev
RTMP_PORT=1935
RTSP_PORT=8554
SRT_PORT=8890
HLS_PORT=8888
UDP_INGEST_PORT_MIN=8900
UDP_INGEST_PORT_MAX=8999

# Phoenix
# mix phx.gen.secret
SECRET_KEY_BASE=

ADMIN_CONTACT=dronefeed@tfeuerbach.dev
# Bootstrap admin (≥8 chars). Clear ADMIN_PASSWORD after first login if desired.
ADMIN_EMAIL=
ADMIN_PASSWORD=

RETENTION_DAYS=5

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=drone_feed_prod

# SES SMTP (blank disables outbound mail)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dronefeed@tfeuerbach.dev
SMTP_FROM_NAME=DroneFeed
SMTP_USE_TLS=true
SMTP_SSL=false

# Iframe embed in research tools (login inside cross-origin iframe)
# Requires HTTPS. SESSION_SAME_SITE=None (or EMBED_COOKIES=true) + FRAME_ANCESTORS.
EMBED_COOKIES=false
# SESSION_SAME_SITE=None
# SESSION_COOKIE_SECURE=true
FRAME_ANCESTORS=
# Example: FRAME_ANCESTORS=*
# Or: FRAME_ANCESTORS=https://gladius.example.com https://*.research.example.com
