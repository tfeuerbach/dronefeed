# Sizing: see deploy/README.md (c7i.2xlarge for ≤4 public feeds @720p; c7i.4xlarge+ for more).
# DroneFeed production env — copy to deploy/.env

# Host — start with the Elastic IP (no domain / no TLS required).
# Example: PHX_HOST=34.202.91.90  MEDIA_IP=34.202.91.90
PHX_HOST=
MEDIA_IP=
MEDIA_HOST=
# Plain HTTP for IP-only installs (open http://IP). After you add DNS, switch to
# CADDYFILE=Caddyfile, PHX_SCHEME=https, and set ACME_EMAIL for Let's Encrypt.
# Self-signed alternative: CADDYFILE=Caddyfile.selfsigned + PHX_SCHEME=https
CADDYFILE=Caddyfile.http
PHX_SCHEME=http
ACME_EMAIL=unused@example.com
RTMP_PORT=1935
RTSP_PORT=8554
SRT_PORT=8890
HLS_PORT=8888
UDP_INGEST_PORT_MIN=8900
UDP_INGEST_PORT_MAX=8999

# Phoenix
# mix phx.gen.secret
SECRET_KEY_BASE=

# Shown on login / access emails — set to a real inbox for your deployment
ADMIN_CONTACT=admin@example.com
# Bootstrap admin (≥8 chars). Clear ADMIN_PASSWORD after first login if desired.
ADMIN_EMAIL=
ADMIN_PASSWORD=

RETENTION_DAYS=5

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=drone_feed_prod

# SES SMTP (blank disables outbound mail)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=DroneFeed
SMTP_USE_TLS=true
SMTP_SSL=false

# Iframe embed in research tools (login inside cross-origin iframe)
# Requires HTTPS. SESSION_SAME_SITE=None (or EMBED_COOKIES=true) + FRAME_ANCESTORS.
EMBED_COOKIES=false
# SESSION_SAME_SITE=None
# SESSION_COOKIE_SECURE=true
FRAME_ANCESTORS=
# Example: FRAME_ANCESTORS=*
# Or: FRAME_ANCESTORS=https://gladius.example.com https://*.research.example.com

# Public VOD SRT pull / distribution encode (optional; compose defaults apply)
# SRT_PULL_LATENCY_MS=2000
# Output height in pixels (720, 1080, …). Use 0 or source to keep source resolution.
PUBLISH_VIDEO_HEIGHT=720
PUBLISH_VIDEO_BITRATE=2.5M
PUBLISH_VIDEO_MAXRATE=2.5M
PUBLISH_VIDEO_BUFSIZE=5M
# PUBLISH_GOP=30
# PUBLISH_X264_PRESET=veryfast
# PUBLISH_X264_PROFILE=main
