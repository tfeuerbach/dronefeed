# =============================================================================
# DroneFeed — production environment (copy to deploy/.env and fill in)
# =============================================================================

# --- Domain / TLS (Caddy + Let's Encrypt) ---
PHX_HOST=dronefeed.tfeuerbach.dev
ACME_EMAIL=dronefeed@tfeuerbach.dev

# --- Media pull endpoints ---
# Public IPv4 (Elastic IP) shown to clients for RTMP/RTSP.
MEDIA_IP=
MEDIA_HOST=dronefeed.tfeuerbach.dev
RTMP_PORT=1935
RTSP_PORT=8554
HLS_PORT=8888

# --- Phoenix ---
# Generate: cd apps/web && mix phx.gen.secret
SECRET_KEY_BASE=

ADMIN_CONTACT=dronefeed@tfeuerbach.dev

# First admin (created/promoted on boot). Password ≥ 8 chars for new users.
# Clear ADMIN_PASSWORD after first successful login if you prefer.
ADMIN_EMAIL=
ADMIN_PASSWORD=

RETENTION_DAYS=5

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=drone_feed_prod

# --- Outbound email (AWS SES SMTP) — leave blank to disable ---
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dronefeed@tfeuerbach.dev
SMTP_FROM_NAME=DroneFeed
# STARTTLS on 587 (SES). Use SMTP_SSL=true only for port 465.
SMTP_USE_TLS=true
SMTP_SSL=false
